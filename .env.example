# Taekwondo Referee Portal - Environment Template
# Copy to .env and fill real values

# ========================================
# DATABASE (Required - MongoDB Atlas)
# ========================================
MONGODB_URI=your-mongodb-connection-string-here

# ========================================
# AUTH (Required)
# ========================================
JWT_SECRET=generate-64-char-secret-here
ADMIN_SETUP_KEY=your-admin-setup-password

# ========================================
# CLOUDINARY (Required for uploads)
# ========================================
CLOUDINARY_CLOUD_NAME=dxddxxxx
CLOUDINARY_API_KEY=xxxxxxx
CLOUDINARY_API_SECRET=xxxxxxx

# ========================================
# SERVER (Optional)
# ========================================
PORT=8000
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ========================================
# DNS (Optional)
# ========================================
DNS_SERVERS=1.1.1.1,8.8.8.8

## Setup:
# 1. MongoDB Atlas: Free cluster → Connection String
# 2. https://cloudinary.com → Free account
# 3. Generate JWT_SECRET: openssl rand -base64 48
