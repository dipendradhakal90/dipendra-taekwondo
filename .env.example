# Taekwondo Referee Portal - Environment Variables

# ========================================
# DATABASE (Required)
# ========================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&amp;w=majority
# Get from MongoDB Atlas: https://www.mongodb.com/atlas

# ========================================
# AUTHENTICATION (Required)
# ========================================
JWT_SECRET=your-super-secure-jwt-secret-minimum-32-chars
ADMIN_SETUP_KEY=your-admin-setup-key-for-first-login

# ========================================
# CLOUDINARY (Required for uploads)
# ========================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Get free account: https://cloudinary.com

# ========================================
# SERVER (Optional)
# ========================================
PORT=8000
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
NODE_ENV=production

# ========================================
# DNS (Optional - for MongoDB SRV issues)
# ========================================
DNS_SERVERS=1.1.1.1,8.8.8.8

## Quick Start:
# 1. Copy to .env
# 2. npm i (backend/frontend)
# 3. MongoDB Atlas free cluster
# 4. Cloudinary free account
# 5. backend: npm start
# 6. frontend: npm start

